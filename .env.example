# Copy to .env and fill in. NEVER commit .env.

# Neon Postgres connection string (the Neon setup step writes this into .env for you).
# On Vercel, use the pooled one (host contains "-pooler").
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret for signing login cookies, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Used once by `npm run db:seed` to create the first admin account.
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
